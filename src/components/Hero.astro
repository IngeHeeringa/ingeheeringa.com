---
import { Image } from "astro:assets";
import lightPhoto from "../assets/light.webp";
import darkPhoto from "../assets/dark.webp";
---

<section class="hero">
  <div class="hero__intro">
    <h1 class="hero__name">Inge Heeringa</h1>
    <p class="hero__title">Software Engineer & Language Enthusiast</p>
    <p class="hero__bio">
      I'm a Dutch software engineer based in Barcelona, working in mobile
      gaming. I hold a degree in Spanish Language and Literature and am
      currently exploring the intersection of language and AI. I am curious
      about combining human language structures with technical solutions to
      solve complex problems.
    </p>
    <div class="hero__socials">
      <a
        class="hero__social-link"
        href="https://www.linkedin.com/in/inge-heeringa/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Inge Heeringa on LinkedIn (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.114 20.452H3.558V9h3.556v11.452z"
          ></path>
        </svg>
      </a>
      <a
        class="hero__social-link"
        href="https://github.com/ingeheeringa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Inge Heeringa on GitHub (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero__divider" aria-hidden="true"></div>

  <div class="hero__photos">
    <Image
      class="hero__photo hero__photo--light"
      src={lightPhoto}
      alt="Photo collage of Inge Heeringa"
      width={800}
      loading="eager"
      fetchpriority="high"
    />
    <Image
      class="hero__photo hero__photo--dark"
      src={darkPhoto}
      alt="Photo collage of Inge Heeringa"
      width={800}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 6vw, 3rem);
    align-items: center;
    align-content: center;
    min-height: calc(100svh - 4.75rem);
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 5vw, 3rem);
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 1.1;
    color: var(--color-text);
    text-align: center;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8125rem;
    color: var(--color-accent);
    text-align: center;
  }

  .hero__bio {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 60ch;
    color: var(--color-text-muted);
    text-align: left;
    margin-top: 0.5rem;
  }

  .hero__socials {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--color-text);
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    transition: color 0.2s ease;
  }

  .hero__social-link:hover {
    color: var(--color-accent);
  }

  .hero__social-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero__divider {
    display: none;
  }

  .hero__photos {
    position: relative;
    width: 66.6667%;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero__photo--light {
      display: none;
    }
    :root:not([data-theme="light"]) .hero__photo--dark {
      display: block;
    }
  }

  :root[data-theme="dark"] .hero__photo--light {
    display: none;
  }

  :root[data-theme="dark"] .hero__photo--dark {
    display: block;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 2fr auto 1fr;
    }

    .hero__intro {
      align-items: flex-start;
    }

    .hero__name,
    .hero__title {
      text-align: left;
    }

    .hero__title {
      font-size: 1rem;
    }

    .hero__divider {
      display: block;
      align-self: stretch;
      width: 1px;
      background: var(--color-border);
    }

    .hero__photos {
      width: 100%;
      margin-inline: 0;
    }
  }
</style>
